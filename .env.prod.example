# Template cho stack production (docker-compose.prod.yml) — copy thành `.env.prod`
# trên VPS, điền giá trị thật, KHÔNG BAO GIỜ commit file `.env.prod` thật.
#
# LUÔN chạy stack qua `./scripts/dc.sh` — nó tự kèm `--env-file .env.prod`.

# --- Domain (dùng cho cả nginx template lẫn biến runtime) ---
# Giai đoạn demo: rg-nqhuy.io.vn. Chuyển sang tên miền khách hàng: xem VPS.md §10.
DOMAIN=rg-nqhuy.io.vn

# Lần khởi động ĐẦU TIÊN (chưa có chứng chỉ) phải là bootstrap.conf.template;
# sau khi certbot cấp xong thì đổi sang lahr.conf.template. Xem VPS.md §6.
NGINX_CONF=bootstrap.conf.template

# --- Image đã build & push bởi CI (.github/workflows/ci.yml, job `images`) ---
BACKEND_IMAGE=ghcr.io/nqhuy-212/lahr-backend:latest
FRONTEND_IMAGE=ghcr.io/nqhuy-212/lahr-frontend:latest

# --- Postgres ---
POSTGRES_USER=lagroup
POSTGRES_PASSWORD=doi-mat-khau-that-manh-o-day
POSTGRES_DB=lagroup

# --- Biến runtime của backend (app/core/config.py:Settings) ---
ENVIRONMENT=prod
# ⚠️ Mật khẩu ở đây PHẢI khớp POSTGRES_PASSWORD bên trên — lệch là backend
# restart liên tục, đây là lỗi hay gặp nhất khi cài lần đầu.
DATABASE_URL=postgresql+psycopg2://lagroup:doi-mat-khau-that-manh-o-day@postgres:5432/lagroup
CORS_ORIGINS=["https://rg-nqhuy.io.vn"]

JWT_SECRET_KEY=doi-secret-that-dai-ngau-nhien-o-day
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=7

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
CHAT_DAILY_TOKEN_BUDGET=200000

UPLOAD_DIR=/uploads
MAX_UPLOAD_BYTES=5242880

N8N_WEBHOOK_URL=
# Backend dùng để dựng link việc làm trong câu trả lời chatbot (chat_service.py).
PUBLIC_SITE_URL=https://rg-nqhuy.io.vn

# --- Biến runtime của frontend ---
# Cố ý KHÔNG có tiền tố NEXT_PUBLIC_ (chỉ dùng ở Server Component) — nhờ vậy đổi
# domain chỉ cần sửa file này + restart, không phải build lại image.
SITE_URL=https://rg-nqhuy.io.vn

# --- scripts/backup.sh & restore.sh ---
# backup.sh tự nạp file này, nên cứ điền thẳng ở đây (bỏ dấu # đầu dòng).
RCLONE_REMOTE=b2:lahr-backups
# ⚠️ Lưu key này RA NGOÀI VPS. Mất key = mất toàn bộ backup, không cách nào giải mã.
BACKUP_ENCRYPTION_KEY=doi-passphrase-that-manh-o-day
